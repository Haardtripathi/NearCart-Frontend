VITE_APP_NAME=NearKart
VITE_API_BASE_URL=http://127.0.0.1:5002/api
# Only used client-side to render the Google Map/pin picker (@react-google-maps/api).
# Autocomplete/geocoding calls go through the backend proxy (see src/api/location.ts) so this
# key only needs the "Maps JavaScript API" enabled and should be restricted to this site's origin.
VITE_GOOGLE_MAPS_API_KEY=
